# Base URL of the portfolio RAG API that powers the chat assistant.
#
# Local development: leave this unset (or empty) — the app falls back to
# http://localhost:8003, which is where `npm run dev:api` serves the backend.
#
# Production: set this to the deployed backend's origin, with no trailing
# slash, e.g. https://ahmed-portfolio-api.onrender.com
# It is read at BUILD time, so rebuild the frontend after changing it.
VITE_API_URL=
