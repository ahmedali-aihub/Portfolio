# Get a free key at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Optional — shown to OpenRouter for attribution, not required
SITE_URL=http://localhost:5173
SITE_NAME=Ahmed Ali Portfolio

# Optional — comma-separated fallback chain, tried in order. Leave unset to
# use the defaults in app/config.py. If you override it, verify the models
# still resolve at https://openrouter.ai/models?max_price=0 — free-tier
# availability rotates.
# OPENROUTER_MODELS=google/gemma-4-26b-a4b-it:free,google/gemma-4-31b-it:free

# Comma-separated origins allowed to call this API
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
